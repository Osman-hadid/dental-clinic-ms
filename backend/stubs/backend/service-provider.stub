<?php

declare(strict_types=1);

namespace App\Modules\{{ module }}\Infrastructure\Providers;

use Illuminate\Foundation\Support\Providers\AuthServiceProvider as BaseAuthServiceProvider;
use App\Modules\{{ module }}\Domain\Entities\{{ entity }};
use App\Modules\{{ module }}\Application\Policies\{{ entity }}Policy;
use App\Modules\{{ module }}\Domain\Repositories\{{ entity }}RepositoryInterface;
use App\Modules\{{ module }}\Infrastructure\Repositories\Eloquent{{ entity }}Repository;

final class {{ module }}ServiceProvider extends BaseAuthServiceProvider
{
    protected $policies = [
        {{ entity }}::class => {{ entity }}Policy::class,
    ];

    public function register(): void
    {
        $this->registerBindings();
    }

    public function boot(): void
    {
        $this->registerPolicies();

        $this->loadRoutesFrom(path: modulePath(module: '{{ module }}', path: 'Routes/api.php'));
    }

    protected function registerBindings(): void
    {
        $this->app->bind(abstract: {{ entity }}RepositoryInterface::class, concrete: Eloquent{{ entity }}Repository::class);
    }
}
