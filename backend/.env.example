APP_NAME=SOURIRE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sourire
DB_USERNAME=sourire
DB_PASSWORD=sourire

# SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_EXPIRE_ON_CLOSE=true
SESSION_DRIVER=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_PREFIX=sourire_cache_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VERIFY_SSL=true
OPENAI_CA_BUNDLE=

AI_IMAGING_PROVIDER=dental_disease_detection
AI_IMAGING_TIMEOUT=180
DENTAL_DISEASE_DETECTION_PYTHON=python
DENTAL_DISEASE_DETECTION_REPO_PATH=
DENTAL_DISEASE_DETECTION_SCRIPT_PATH=
DENTAL_DISEASE_DETECTION_MODEL_PATH=
DENTAL_DISEASE_DETECTION_CONF=0.25
DENTAL_DISEASE_DETECTION_FALLBACK_CONF=0.10
DENTAL_DISEASE_DETECTION_IOU=0.45
DENTAL_DISEASE_DETECTION_IMGSZ=1280
DENTAL_DISEASE_DETECTION_AUGMENT=false
DENTAL_DISEASE_DETECTION_MULTI_PASS=true
